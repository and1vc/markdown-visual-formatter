{
  "name": "markdown-visual-formatter",
  "displayName": "Markdown Visual Formatter",
  "description": "Visual formatting toolbar for Markdown cells in Jupyter notebooks, with text highlighting, text and background colors, and clear formatting.",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/and1vc/markdown-visual-formatter.git"
  },
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdown-visual-formatter.highlightText",
        "title": "Resaltar texto",
        "icon": "$(pencil)"
      },
      {
        "command": "markdown-visual-formatter.setTextColor",
        "title": "Color de texto",
        "icon": "$(symbol-color)"
      },
      {
        "command": "markdown-visual-formatter.setBackgroundColor",
        "title": "Color de fondo",
        "icon": "$(paintcan)"
      },
      {
        "command": "markdown-visual-formatter.clearFormatting",
        "title": "Borrar formato",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "notebook/cell/title": [
        {
          "command": "markdown-visual-formatter.highlightText",
          "when": "notebookType == jupyter-notebook && notebookCellType == markup",
          "group": "inline@1"
        },
        {
          "command": "markdown-visual-formatter.setTextColor",
          "when": "notebookType == jupyter-notebook && notebookCellType == markup",
          "group": "inline@2"
        },
        {
          "command": "markdown-visual-formatter.setBackgroundColor",
          "when": "notebookType == jupyter-notebook && notebookCellType == markup",
          "group": "inline@3"
        },
        {
          "command": "markdown-visual-formatter.clearFormatting",
          "when": "notebookType == jupyter-notebook && notebookCellType == markup",
          "group": "inline@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
